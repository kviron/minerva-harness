{
  "name": "oe-rig-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "tauri:dev": "tauri dev",
    "test": "node --test tests/*.test.mjs",
    "server": "cargo run -p minerva-server --",
    "dev:web": "cargo run -p minerva-server -- --dev-origin http://127.0.0.1:1420",
    "test:e2e:web": "cargo build -p minerva-server && npm run build && playwright test",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "plugin:example": "cargo build -p minerva-review-example && node scripts/package-review-example.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.36",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cordis": "4.0.0-rc.12",
    "dompurify": "3.4.17",
    "lucide-react": "^0.468.0",
    "marked": "14.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.21.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
